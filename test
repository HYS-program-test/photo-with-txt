<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <title>露天圖書館登入畫面</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body, html { width: 100%; height: 100%; overflow: hidden; font-family: sans-serif; }

    /* 背景容器：包含晴天與圖書館環形結構 */
    .sky-background {
      position: absolute;
      width: 100%; height: 100%;
      background: linear-gradient(to bottom, #72c6ef 0%, #0085ca 100%);
      z-index: 1;
    }

    /* 雲朵動畫 */
    .cloud {
      position: absolute; background: rgba(255, 255, 255, 0.8);
      border-radius: 50px; animation: moveClouds 25s linear infinite;
    }
    .cloud::before, .cloud::after {
      content: ''; position: absolute; background: rgba(255, 255, 255, 0.8); border-radius: 50%;
    }
    .cloud1 { width: 120px; height: 40px; top: 15%; left: -150px; }
    .cloud1::before { width: 50px; height: 50px; top: -20px; left: 20px; }
    .cloud1::after { width: 40px; height: 40px; top: -15px; right: 20px; }

    @keyframes moveClouds {
      0% { transform: translateX(0); }
      100% { transform: translateX(calc(100vw + 200px)); }
    }

    /* 草皮與花朵底座 */
    .grass-field {
      position: absolute; bottom: 0; width: 100%; height: 35%;
      background: linear-gradient(to bottom, #7ec850, #419d12);
      border-radius: 50% 50% 0 0 / 20px 20px 0 0;
      z-index: 2;
    }

    /* 登入表單元件 */
    .login-card {
      position: absolute; top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 340px; padding: 30px;
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(8px);
      border-radius: 16px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.15);
      z-index: 10; text-align: center;
    }
    .login-card h2 { color: #2d5a27; margin-bottom: 20px; }
    .login-card input {
      width: 100%; padding: 10px; margin: 8px 0;
      border: 1px solid #ccc; border-radius: 6px;
    }
    .login-card button {
      width: 100%; padding: 10px; margin-top: 12px;
      background: #419d12; color: #fff; border: none;
      border-radius: 6px; font-weight: bold; cursor: pointer;
    }
  </style>
</head>
<body>

  <div class="sky-background">
    <div class="cloud cloud1"></div>
  </div>

  <div class="grass-field"></div>

  <div class="login-card">
    <h2>露天圖書館</h2>
    <input type="text" placeholder="帳號">
    <input type="password" placeholder="密碼">
    <button>登入</button>
  </div>

</body>
</html>
